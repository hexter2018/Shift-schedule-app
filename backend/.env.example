# Path to a folder INSIDE your OneDrive sync tree — e.g. on Windows:
#   C:\Users\phongthep\OneDrive - CompanyName\ScheduleApprovals
# The backend creates requests/, files/, results/, results/processed/, and
# ready_for_hr/ subfolders under this automatically on first use. No
# Azure AD, no admin consent — this only needs OneDrive already signed in
# on this machine.
ONEDRIVE_APPROVALS_ROOT=C:\Users\yourname\OneDrive - CompanyName\ScheduleApprovals

# How often (seconds) the background poller checks active cycles for a
# result file. 60 is a reasonable default for a monthly-schedule workflow.
APPROVAL_POLL_INTERVAL_SECONDS=60

# Signs and verifies login tokens (see backend/auth.py) — every backend
# process must use the SAME value, or tokens issued by one won't validate
# on another. Must be a long, random, secret string — anyone who has it
# can forge a valid login for any email. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Without this set, the backend falls back to an insecure hardcoded value
# and logs a warning on startup — fine for local dev, never for anything
# reachable by anyone else.
AUTH_SECRET_KEY=

# How many hours a login stays valid before the person has to sign in
# again. 12 is a reasonable default for a workday.
AUTH_TOKEN_TTL_HOURS=12

# Comma-separated list of origins allowed to call this API from a
# browser (e.g. https://schedule.example.com). Leave empty for local
# dev — defaults to allowing any origin, which is fine until this
# backend is reachable by anyone but you.
CORS_ALLOWED_ORIGINS=
